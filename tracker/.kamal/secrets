# Kamal secrets for the tracker app.
#
# This file holds NO literal secrets — it reuses the GHCR token already kept in
# api/.kamal/secrets (the single source of truth). The `make tracker-*` targets
# mount the repo root, so the relative path below resolves at deploy time.
#
# Do NOT paste real tokens here; add them to api/.kamal/secrets instead.
KAMAL_REGISTRY_PASSWORD=$(sed -n 's/^KAMAL_REGISTRY_PASSWORD=//p' ../api/.kamal/secrets)
