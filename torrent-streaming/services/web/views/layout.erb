<%# Shared HTML shell for the web UI; page templates supply the main content and title. %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= h(@page_title || "Torrent Streaming") %></title>
    <link rel="stylesheet" href="/app.css">
  </head>
  <body>
    <header class="topbar">
      <div class="shell topbar__inner">
        <a class="brand" href="/">Torrent Streaming</a>
      </div>
    </header>
    <main class="shell page-shell">
      <%= yield %>
    </main>
  </body>
</html>
