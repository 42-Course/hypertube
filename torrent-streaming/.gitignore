storage/
storage/state/*
!/storage/state/.gitkeep
!/storage/state/media/
!/storage/state/media/.gitkeep
!/storage/state/sessions/
!/storage/state/sessions/.gitkeep
!/storage/state/locks/
!/storage/state/locks/.gitkeep
!/storage/state/corrupt/
!/storage/state/corrupt/.gitkeep
/storage/torrents/*
!/storage/torrents/.gitkeep
/storage/libtorrent/*
!/storage/libtorrent/.gitkeep
/storage/hls/*
!/storage/hls/.gitkeep
!/storage/hls/sessions/
!/storage/hls/sessions/.gitkeep
!/storage/hls/vod/
!/storage/hls/vod/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
__pycache__/
*.pyc

# Production secrets — never commit. STREAM_TICKET_SECRET etc. live here.
.env.production
.env.production.local
.env.local
