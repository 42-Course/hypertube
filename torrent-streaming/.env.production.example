# Production environment for the torrent streaming stack.
# Copy to .env.production on the deploy host and fill in real values.
# Consumed by: docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml ...
# (.env.production is gitignored — never commit real secrets.)

# --- Storage -----------------------------------------------------------------
# Host directory that holds the (large, growing) torrent + HLS cache. Must live
# on a disk with plenty of free space. Created/chowned to APP_UID:APP_GID by
# scripts/deploy_prod.sh before the stack starts.
# Points at the 100GB DigitalOcean block volume so the cache does not fill the
# small root disk.
STREAMING_STORAGE_ROOT=/mnt/volume_fra1_1782106877902/streaming

# Non-root UID/GID baked into the images and owning STREAMING_STORAGE_ROOT.
APP_UID=10001
APP_GID=10001

# --- Viewer auth (browser -> streaming) --------------------------------------
# MUST be byte-for-byte identical to STREAM_TICKET_SECRET in api/.env.production:
# the API signs viewer tickets with it and this service verifies them locally.
STREAM_TICKET_SECRET=

# SPA origin allowed to call the streaming API from the browser (CORS).
CORS_ALLOWED_ORIGINS=https://hypertube.fractalia.art

# --- BitTorrent --------------------------------------------------------------
# Published on the host for inbound peer connections (open this port in the
# firewall, tcp+udp). 6881 is the conventional default.
BITTORRENT_PORT=6881
BITTORRENT_DISCOVERY_PROFILE=standard
RANGE_SERVER_CACHE_MODE=readwrite
