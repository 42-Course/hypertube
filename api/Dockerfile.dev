FROM ruby:3.3-slim

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      postgresql-client \
      libyaml-dev \
      git \
      curl \
      openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# All gems (including rails itself) go into the bundle_cache volume at /gems.
# Nothing is pre-installed into the image init.sh does `bundle install` first
# using the bootstrap Gemfile (gem 'rails'), which puts the rails binary into
# /gems/bin before `rails new` is called.
ENV GEM_HOME=/gems \
    BUNDLE_PATH=/gems \
    BUNDLE_BIN=/gems/bin \
    BUNDLE_APP_CONFIG=/gems

ENV PATH="/gems/bin:${PATH}"

COPY entrypoint.sh /usr/bin/entrypoint.sh
RUN chmod +x /usr/bin/entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["entrypoint.sh"]
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0"]
