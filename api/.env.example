# ─── Copy this file to .env.local (development) or .env.production ───────────
# IMPORTANT: Never commit .env.local or .env.production to git

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=hypertube_development
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme

# ── Rails ────────────────────────────────────────────────────────────────────
RAILS_ENV=development
SECRET_KEY_BASE=generate_with_rails_secret
RAILS_MAX_THREADS=5

# ── JWT (devise-jwt) ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=

# ── OAuth2 – 42 Intra ────────────────────────────────────────────────────────
# Register at: https://profile.intra.42.fr/oauth/applications
OMNIAUTH_42_CLIENT_ID=
OMNIAUTH_42_CLIENT_SECRET=
OMNIAUTH_42_REDIRECT_URI=http://localhost:3000/users/auth/fortytwo/callback

# ── OAuth2 – Google ───────────────────────────────────────────────────────────
# Register at: https://console.cloud.google.com
OMNIAUTH_GOOGLE_CLIENT_ID=
OMNIAUTH_GOOGLE_CLIENT_SECRET=

# ── Streaming service (separate app) ─────────────────────────────────────────
# Shared HMAC secret used to sign/verify stream tickets. MUST be identical in
# the streaming service. Generate with: openssl rand -hex 64
STREAM_TICKET_SECRET=
# Public base URL of the streaming service, returned to the SPA (browser-facing).
STREAMING_SERVICE_URL=http://localhost:4567
# Internal base URL the API uses for server-to-server calls (movie->media
# handoff). Defaults to STREAMING_SERVICE_URL; set when the internal Docker
# hostname differs from the public one, e.g. http://streaming-web:4567
STREAMING_SERVICE_INTERNAL_URL=

# ── Frontend (used for CORS) ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── API URL (used in Swagger docs) ───────────────────────────────────────────
API_URL=http://localhost:3000

# ── Email / SMTP (for password reset) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_FROM=noreply@hypertube.local

# ── Redis / Sidekiq ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── External APIs ─────────────────────────────────────────────────────────────
# OMDb (movie metadata): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# TMDB (movie metadata / discovery): https://developer.themoviedb.org
TMDB_API_KEY=
# Prowlarr (self-hosted torrent indexer aggregator; provides the magnets)
PROWLARR_URL=
PROWLARR_API_KEY=
