# ─── Copy this file to .env.local (development) or .env.production ───────────
# IMPORTANT: Never commit .env.local or .env.production to git
# All variables MUST be prefixed with VITE_ to be accessible in the browser

# URL of the Rails API
VITE_API_URL=http://localhost:3000

# App name shown in browser tab / meta
VITE_APP_NAME=Hypertube
